# SMTP settings for the dedicated sending mailbox.
# Use any mailbox/provider that gives you SMTP credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=inquiries@example.com
SMTP_PASS=replace-with-mailbox-password-or-app-password

# Sender and recipients for apartment inquiries.
# Many SMTP providers require INQUIRY_FROM_EMAIL to match SMTP_USER.
INQUIRY_FROM_EMAIL="LOLA <inquiries@example.com>"
INQUIRY_TO_EMAILS=h18@jeremyzimmer-immobilien.de
INQUIRY_BCC_EMAILS=afg@afg-ia.de
NEXT_PUBLIC_SITE_URL=https://www.lolaliving.de
